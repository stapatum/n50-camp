---
import "../styles/global.css";
import "../styles/header.css";
import Tents from "../components/Tents.astro";
import { listNavLinks } from "../lib/db";

// Header nav links are admin-managed (see /admin/nav). The inline --i centred
// at 1.5 keeps the row centred for any link count; the matching CSS formula is
// (var(--i) − 1.5)·5em.
const topNav = listNavLinks("top");
const n = topNav.length;
const iFor = (k: number) => (n <= 1 ? 1.5 : k - (n - 1) / 2 + 1.5);

// Footer nav links share the same nav_links table (placement='bottom').
const bottomNav = listNavLinks("bottom");
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>N50CAMP</title>
    <slot name="head" />
  </head>
  <body>
    <header>
      <Tents />
      <div id="wordmark">
        <h1>N50CAMP</h1>
        <nav>
          <ul>
            {topNav.map((link, k) => (
              <li style={`--i:${iFor(k)}`}>
                <a href={link.url}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <div id="header-backdrop" aria-hidden="true"></div>

    <slot />

    <footer>
      <nav aria-label="Weitere Seiten">
        {bottomNav.map((link) => (
          <a href={link.url}>{link.label}</a>
        ))}
      </nav>
    </footer>
  </body>
</html>
